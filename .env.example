# ==========================================
# ROYAL LUDO ENVIRONMENT CONFIGURATION
# ==========================================

# Server Configuration
PORT=4000
NODE_ENV=development
API_PREFIX=/api

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/royal-ludo
# Optional MongoDB Atlas production string:
# MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/royal-ludo?retryWrites=true&w=majority

# Redis Cache & Pub/Sub (Optional in local dev, recommended for production clustering)
REDIS_URL=redis://localhost:6379

# Security & Secrets
JWT_SECRET=royal_ludo_super_secret_jwt_key_2026_change_in_production
JWT_EXPIRES_IN=7d
CORS_ORIGIN=*

# Client Public Variables (React Native / Expo)
EXPO_PUBLIC_API_URL=http://localhost:4000/api
EXPO_PUBLIC_SOCKET_URL=http://localhost:4000
EXPO_PUBLIC_APP_ENV=development
